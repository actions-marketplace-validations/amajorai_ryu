{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryu Bot",
  "mainBinaryName": "Ryu Bot",
  "identifier": "ai.amajor.ryu.bot",
  "app": {
    "windows": [
      {
        "title": "Ryu Bot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ryubot"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/amajorai/ryu/releases/latest/download/latest-bot.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NTBCRjA0NDQ1QjEyMDEKUldRQkVsdEVCTDlRZDNNQmNTQWU4VmlCMlFjRk5rdXQ0Q0V4WkxhSUFBcmxOTE5oUm81ZTRRTG4K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
