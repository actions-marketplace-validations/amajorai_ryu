{
  "id": "@ryu/durable",
  "name": "Durable Workflows",
  "version": "1.0.0",
  "category": "Core",
  "engines": {
    "ryu": ">=0.0.1"
  },
  "runnables": [
    {
      "id": "engine-durable-workflow",
      "name": "Durable workflow execution engine",
      "kind": "engine",
      "config": {
        "engine_type": "durable_workflow",
        "base_url": "core://workflow/durable"
      }
    }
  ],
  "contributes": {
    "workflows": []
  },
  "permission_grants": [],
  "permission_levels": [
    {
      "id": "workflow.view",
      "label": "Can view runs",
      "description": "See durable workflow runs and their history."
    },
    {
      "id": "workflow.run",
      "label": "Can run",
      "description": "Start a durable workflow and resume a suspended one."
    }
  ]
}
