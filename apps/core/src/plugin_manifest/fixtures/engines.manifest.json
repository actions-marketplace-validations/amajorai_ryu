{
  "id": "@ryu/engines",
  "name": "Local Engines",
  "version": "1.0.0",
  "engines": {
    "ryu": ">=0.0.1"
  },
  "runnables": [
    {
      "id": "engine-llamacpp",
      "name": "llama.cpp (local chat)",
      "kind": "engine",
      "config": {
        "engine_type": "llamacpp",
        "base_url": "http://127.0.0.1:8080"
      }
    },
    {
      "id": "engine-llamacpp-embed",
      "name": "llama.cpp embeddings",
      "kind": "engine",
      "config": {
        "engine_type": "llamacpp_embed",
        "base_url": "http://127.0.0.1:8081"
      }
    }
  ],
  "contributes": {
    "agents": []
  },
  "provides": [
    {
      "capability": "engines",
      "version": "1.0.0"
    }
  ],
  "permission_grants": [],
  "permission_levels": [
    {
      "id": "engines.view",
      "label": "Can view",
      "description": "See the local model engines on this node and whether each is running."
    },
    {
      "id": "engines.manage",
      "label": "Can manage",
      "description": "Install, start, and stop local engines, which downloads multi-gigabyte weights and holds this machine's memory while running.",
      "implies": ["engines.view"]
    }
  ]
}
