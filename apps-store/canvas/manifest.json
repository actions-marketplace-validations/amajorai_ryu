{
  "id": "@ryu/canvas",
  "name": "Canvas",
  "version": "1.0.0",
  "description": "A node board for generative media: wire up image, video, chat, text-to-speech, speech-to-text, upload, and note nodes, then run the graph through Ryu's media and agent bridges. Each board persists as a Space document, so it stays editable, shareable, and searchable.",
  "tagline": "Wire up media and agent nodes on one board",
  "keywords": ["canvas", "media", "nodes", "generative", "workflow"],
  "category": "Creative",
  "icon": "ai-image",
  "iconDither": { "from": 225, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [
    {
      "id": "canvas-companion",
      "name": "Canvas",
      "kind": "companion",
      "config": {
        "label": "Canvas",
        "ui_entry": "./dist/index.html",
        "ui_format": "html",
        "csp": {
          "connect_domains": [
            "https://api.iconify.design",
            "https://api.svgl.app",
            "https://svgl.app"
          ],
          "resource_domains": [
            "https://api.iconify.design",
            "https://api.svgl.app",
            "https://svgl.app"
          ]
        }
      }
    }
  ],
  "requires": {
    "apps": [
      {
        "id": "@ryu/spaces"
      }
    ],
    "grants": ["spaces:docs"]
  },
  "permission_grants": [
    "spaces:docs",
    "core:list_agents",
    "media:generate",
    "media:transcribe",
    "hook:run-agent",
    "hook:side-model"
  ],
  "permission_levels": [
    {
      "id": "canvas.view",
      "label": "Can view",
      "description": "Open canvases and read their contents."
    },
    {
      "id": "canvas.edit",
      "label": "Can edit",
      "description": "Create and change canvases, including the documents they store in Spaces.",
      "implies": ["canvas.view"]
    },
    {
      "id": "canvas.generate",
      "label": "Can generate media",
      "description": "Produce images and transcriptions inside a canvas, which spends model credits on every generation.",
      "implies": ["canvas.edit"]
    }
  ],
  "companion": {
    "label": "Canvas",
    "icon": "ai-image"
  },
  "contributes": {
    "sidebar_sections": [
      {
        "id": "canvas",
        "title": "Canvas",
        "icon": "ai-image",
        "spec": {
          "source": {
            "http": {
              "method": "GET",
              "path": "/api/apps/@ryu/canvas/docs"
            },
            "items": "documents"
          },
          "itemTarget": "/spaces/{{item.space_id}}/app/@ryu/canvas/{{item.id}}",
          "create": {
            "http": {
              "method": "POST",
              "path": "/api/apps/@ryu/canvas/docs"
            },
            "targetFrom": "id",
            "label": "New canvas"
          },
          "itemActions": [
            {
              "id": "delete",
              "label": "Delete",
              "icon": "lucide:trash-2",
              "style": "danger",
              "http": {
                "method": "DELETE",
                "path": "/api/spaces/{{item.space_id}}/documents/{{item.id}}"
              }
            }
          ]
        }
      }
    ]
  }
}
