{
  "id": "@ryu/workflows",
  "name": "Workflows",
  "version": "1.0.0",
  "description": "Workflows: petgraph DAG automation with triggers, durable execution, and a natural-language workflow builder.",
  "icon": "workflow-square-01",
  "iconDither": { "from": 299, "to": 333, "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "workflows-companion",
      "name": "Workflows",
      "kind": "companion",
      "config": {
        "label": "Workflows",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": [
    "workflows:crud",
    "workflows:runstate",
    "workflows:catalogs",
    "ghost:record"
  ],
  "companion": {
    "label": "Workflows",
    "icon": "workflow-square-01"
  }
}
