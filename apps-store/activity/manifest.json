{
  "id": "@ryu/activity",
  "name": "Activity",
  "version": "1.0.0",
  "description": "The unified activity feed: everything happening on this node — monitor alerts, finished tasks, runs, approvals, meetings, and notes — newest first, grouped by day.",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "activity-companion",
      "name": "Activity",
      "kind": "companion",
      "config": {
        "label": "Activity",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["activity:read", "shell:integrate"],
  "companion": {
    "label": "Activity",
    "icon": "activity"
  }
}
