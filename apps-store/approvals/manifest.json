{
  "id": "@ryu/approvals",
  "name": "Approvals",
  "version": "1.0.0",
  "description": "Approval inbox: a human-in-the-loop queue where agent-proposed actions, edits, and fixes wait for your accept or reject before they take effect.",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "approvals-companion",
      "name": "Inbox",
      "kind": "companion",
      "config": {
        "label": "Inbox",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "permission_grants": ["approvals:crud", "quests:crud", "shell:integrate"],
  "companion": {
    "label": "Inbox",
    "icon": "shield-01"
  }
}
