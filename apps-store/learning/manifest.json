{
  "id": "@ryu/learning",
  "name": "Learning",
  "version": "1.0.0",
  "description": "Learning loop: turn chats and runs into reusable skills, gated by the approval Inbox, with an experience log of what was learned.",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "none" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "learning-companion",
      "name": "Learning",
      "kind": "companion",
      "config": {
        "label": "Learning",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "requires": {
    "apps": [
      {
        "id": "@ryu/skills",
        "min_version": "1.0.0"
      }
    ]
  },
  "permission_grants": ["learning:crud"],
  "companion": {
    "label": "Learning",
    "icon": "mortarboard-01"
  },
  "contributes": {
    "settings_tabs": [
      {
        "id": "learning.settings",
        "title": "Learning",
        "scope": "node",
        "view": "learning"
      }
    ]
  }
}
