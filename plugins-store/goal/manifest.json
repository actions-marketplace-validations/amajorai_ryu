{
  "id": "@ryu/goal",
  "name": "Goal",
  "version": "0.1.14",
  "stability": "experimental",
  "description": "Give the agent a goal with `/goal` and it keeps working until a judge model agrees the goal is actually met, re-prompting itself after every turn instead of stopping and waiting for you. `/goal clear` stops the loop; the judge model is configurable.",
  "tagline": "Keep working until a judge model says it's done",
  "keywords": ["agent", "autonomy", "goals", "loop"],
  "category": "Productivity",
  "icon": "flag-03",
  "iconDither": { "from": 291, "to": "transparent", "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "limited" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "permission_grants": ["hook:side-model", "storage:kv"],
  "activation_events": ["*"],
  "contributes": {
    "slash_commands": [
      {
        "id": "goal.set",
        "command": "/goal",
        "description": "Pursue a goal until a judge model says it is met. Use '/goal clear' to stop."
      }
    ],
    "settings_tabs": [
      {
        "id": "goal.settings",
        "title": "Goals",
        "fields": [
          {
            "type": "model_picker",
            "pref_key": "goal-judge-model",
            "label": "Judge model",
            "description": "Optional model that evaluates whether the goal was met. Leave empty to use the node's default."
          }
        ]
      }
    ],
    "turn_hooks": [
      {
        "id": "goal.loop",
        "on": "post_assistant_turn",
        "match": {
          "commands": ["/goal"],
          "stateful": true
        },
        "code_file": "hooks/loop.js"
      }
    ]
  }
}
