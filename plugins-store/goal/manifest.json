{
  "id": "@ryu/goal",
  "name": "Goal",
  "version": "1.0.0",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "limited" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "runnables": [],
  "permission_grants": ["hook:side-model", "storage:kv"],
  "activation_events": ["*"],
  "contributes": {
    "slash_commands": [
      {
        "id": "goal.set",
        "command": "/goal",
        "description": "Pursue a goal until a judge model says it is met. Use '/goal clear' to stop."
      }
    ],
    "settings_tabs": [
      {
        "id": "goal.settings",
        "title": "Goals",
        "fields": [
          {
            "type": "model_picker",
            "pref_key": "goal-judge-model",
            "label": "Judge model"
          }
        ]
      }
    ],
    "turn_hooks": [
      {
        "id": "goal.loop",
        "on": "post_assistant_turn",
        "match": {
          "commands": ["/goal"],
          "stateful": true
        },
        "code_file": "hooks/loop.js"
      }
    ]
  }
}
