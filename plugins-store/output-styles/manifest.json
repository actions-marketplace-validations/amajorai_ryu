{
  "id": "@ryu/output-styles",
  "name": "Output Styles",
  "version": "1.0.0",
  "category": "Productivity",
  "description": "The nine built-in output styles \u2014 ELI5, I have ADHD, Explanatory, Learning, Proactive, Plain text, No AI slop, Bro and Gen Z. A style is appended to (or replaces) the agent's base instructions for the turn, so it changes how the agent talks \u2014 role, tone, default response shape \u2014 and never what it knows, which tools it has, or which model runs. Pick one in the composer; browse them in the Store's Output Styles tab.",
  "tagline": "Change how the agent talks, not what it knows",
  "keywords": [
    "output-style",
    "tone",
    "prompt",
    "accessibility",
    "writing"
  ],
  "icon": "quill-write-01",
  "iconDither": {
    "from": 150,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "full"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "activation_events": [
    "*"
  ],
  "contributes": {
    "output_styles": [
      {
        "id": "eli5",
        "file": "output-styles/eli5.md"
      },
      {
        "id": "i-have-adhd",
        "file": "output-styles/i-have-adhd.md"
      },
      {
        "id": "explanatory",
        "file": "output-styles/explanatory.md"
      },
      {
        "id": "learning",
        "file": "output-styles/learning.md"
      },
      {
        "id": "proactive",
        "file": "output-styles/proactive.md"
      },
      {
        "id": "plain-text",
        "file": "output-styles/plain-text.md"
      },
      {
        "id": "no-ai-slop",
        "file": "output-styles/no-ai-slop.md"
      },
      {
        "id": "bro",
        "file": "output-styles/bro.md"
      },
      {
        "id": "gen-z",
        "file": "output-styles/gen-z.md"
      }
    ],
    "store_tabs": [
      {
        "id": "output-styles",
        "title": "Output Styles",
        "subtitle": "A style changes how the agent talks \u2014 its role, tone and the shape of its answers. It never changes what the agent knows or which model runs.",
        "icon": "lucide:message-square-quote",
        "group": "catalog",
        "order": 80,
        "spec": {
          "source": {
            "http": {
              "method": "GET",
              "path": "/api/output-styles"
            },
            "items": "styles"
          },
          "map": {
            "id": "id",
            "title": "name",
            "description": "description",
            "installed": "active"
          },
          "searchPlaceholder": "Search output styles\u2026",
          "install": {
            "http": {
              "method": "POST",
              "path": "/api/output-styles/select",
              "body": {
                "style_id": "{{item.id}}"
              }
            },
            "label": "Use",
            "successMessage": "Output style selected"
          },
          "empty": {
            "title": "No output styles found",
            "description": "Try a different search."
          }
        }
      }
    ]
  }
}
