{
  "id": "@ryu/pi-subagent",
  "name": "Subagents",
  "version": "1.0.0",
  "category": "Automation",
  "description": "Adds the Task tool to the managed Pi agent, so it can delegate a bounded, context-isolated job to a child agent.",
  "tagline": "Let the agent delegate work to child agents",
  "keywords": ["subagent", "delegation", "automation", "agent"],
  "icon": "user-multiple-02",
  "iconDither": { "from": 12, "to": 46, "direction": "down" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "limited" },
    "web": { "support": "limited" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "activation_events": ["*"],
  "contributes": {
    "pi_extensions": [
      {
        "id": "subagent",
        "file": "pi-extensions/ryu-subagent.ts",
        "description": "Sub-agent delegation (the Task tool) for the managed Pi agent."
      }
    ]
  }
}
