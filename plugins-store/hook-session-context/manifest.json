{
  "id": "@ryu/session-context",
  "name": "Session Context",
  "version": "1.0.0",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "full" },
    "mobile": { "support": "full" },
    "extension": { "support": "full" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "permission_grants": [],
  "activation_events": ["*"],
  "contributes": {
    "turn_hooks": [
      {
        "id": "session-context.start",
        "on": "session_start",
        "code_file": "hooks/start.js"
      }
    ]
  }
}
