{
  "id": "@ryu/csharp-lsp",
  "name": "C# LSP",
  "version": "0.1.14",
  "stability": "experimental",
  "category": "Developer Tools",
  "description": "C# language server (csharp-ls) for the ryu agent: definitions, references, hover, symbols, implementations, call hierarchies and diagnostics after every edit. You install csharp-ls; the plugin ships config.",
  "tagline": "C# code intelligence via csharp-ls",
  "keywords": [
    "c#",
    "dotnet",
    "csharp-ls",
    "language-server",
    "developer"
  ],
  "icon": "code-square-01",
  "iconDither": {
    "from": 64,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "limited"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "activation_events": [
    "*"
  ],
  "contributes": {
    "lsp_servers": {
      "csharp-ls": {
        "command": "csharp-ls",
        "extensionToLanguage": {
          ".cs": "csharp"
        }
      }
    }
  }
}
