{
  "id": "@ryu/observer-agents",
  "name": "Observer Agents",
  "version": "0.1.0",
  "stability": "experimental",
  "category": "Security",
  "description": "Adds an opt-in background reviewer that watches the latest agent activity and sends concise advisory reports when it spots drift, missed constraints, or shortcuts.",
  "tagline": "A quiet watchdog for long-running agent work",
  "keywords": ["observer", "watchdog", "review", "agents", "safety"],
  "icon": "eye",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "limited" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "permission_grants": ["hook:side-model"],
  "activation_events": ["*"],
  "contributes": {
    "composer_controls": [
      {
        "id": "observer-agents.toggle",
        "type": "toggle",
        "flag": "io.ryu.observer-agents",
        "label": "Observer",
        "description": "Have a quiet reviewer watch the agent's latest activity."
      }
    ],
    "settings_tabs": [
      {
        "id": "observer-agents.settings",
        "title": "Observer agents",
        "fields": [
          {
            "type": "model_picker",
            "pref_key": "observer-agents-model",
            "label": "Observer model",
            "description": "Optional model used by the read-only watchdog. Leave empty to use the node default."
          }
        ]
      }
    ],
    "turn_hooks": [
      {
        "id": "observer-agents.review",
        "on": "post_assistant_turn",
        "match": { "flag": "io.ryu.observer-agents" },
        "code_file": "hooks/review.js"
      }
    ]
  }
}
