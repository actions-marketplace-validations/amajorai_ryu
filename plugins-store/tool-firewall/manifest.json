{
  "id": "@ryu/tool-firewall",
  "name": "Tool Firewall",
  "version": "1.0.0",
  "category": "Security",
  "icon": "shield-ban",
  "iconDither": { "from": 14, "to": 340, "direction": "left" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "full" },
    "mobile": { "support": "full" },
    "extension": { "support": "full" },
    "web": { "support": "full" },
    "cli": { "support": "full" }
  },
  "engines": { "ryu": ">=0.1.0" },
  "runnables": [],
  "permission_grants": [],
  "activation_events": ["*"],
  "contributes": {
    "turn_hooks": [
      {
        "id": "tool-firewall.pre",
        "on": "pre_tool_use",
        "match": { "tools": ["*"] },
        "code_file": "hooks/pre.js"
      },
      {
        "id": "tool-firewall.post",
        "on": "post_tool_use",
        "match": { "tools": ["*"] },
        "code_file": "hooks/post.js"
      }
    ]
  }
}
