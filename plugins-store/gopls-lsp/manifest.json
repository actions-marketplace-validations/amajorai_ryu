{
  "id": "@ryu/gopls-lsp",
  "name": "Go LSP",
  "version": "0.1.14",
  "category": "Developer Tools",
  "description": "Go language server (gopls) for the ryu agent: definitions, references, hover, symbols, implementations, call hierarchies and diagnostics after every edit. You install gopls; the plugin ships config.",
  "tagline": "Go code intelligence via gopls",
  "keywords": [
    "go",
    "golang",
    "gopls",
    "language-server",
    "developer"
  ],
  "icon": "code-02",
  "iconDither": {
    "from": 96,
    "to": "transparent",
    "direction": "down"
  },
  "surfaces": {
    "gateway": {
      "support": "none"
    },
    "core": {
      "support": "full"
    },
    "desktop": {
      "support": "full"
    },
    "island": {
      "support": "limited"
    },
    "mobile": {
      "support": "limited"
    },
    "extension": {
      "support": "limited"
    },
    "web": {
      "support": "limited"
    },
    "cli": {
      "support": "full"
    }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [],
  "activation_events": [
    "*"
  ],
  "contributes": {
    "lsp_servers": {
      "gopls": {
        "command": "gopls",
        "extensionToLanguage": {
          ".go": "go"
        }
      }
    }
  }
}
